# Web / CS authentication
WEB_BIND=127.0.0.1
WEB_PORT=8091
PUBLIC_BASE_URL=https://cs.example.com
WEB_SECRET_KEY=
CS_ACCESS_PIN_HASH=
WEB_SESSION_HOURS=12
WEB_COOKIE_SECURE=true

# Google Sheet source and optional write-back webhook
SHEET_ID=
SHEET_GID=
SHEET_TRACKING_COLUMN=G
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# KLEAN&KARE / Skyfrog
SKYFROG_CUSTOMER_CODE=
SKYFROG_USERNAME=
SKYFROG_PASSWORD=

# KEX and InterExpress
KEX_PROOF_PIN=
INTEREXPRESS_USERNAME=
INTEREXPRESS_PASSWORD=

# Supabase service-role/secret key (server-side only)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_MAPPING_TABLE=shopee_order_mapping
SUPABASE_STATUS_TABLE=tracking_status_cache

# Runtime
REQUEST_TIMEOUT_SECONDS=30
REQUEST_DELAY_SECONDS=0.10
CONCURRENCY=2
SCHEDULE_TIMEZONE=Asia/Bangkok
SCHEDULE_START_HOUR=8
SCHEDULE_END_HOUR=22
SCHEDULE_MINUTE=0
SCHEDULE_RUN_ON_START=false

# Optional Shopee automation profile
SHOPEE_LOGIN_URL=https://seller.shopee.co.th/account/signin
SHOPEE_REPORT_GLOB=Order.all.*.xlsx
# Host folder mounted read-only into web so /admin can verify report freshness
SHOPEE_REPORT_HOST_PATH=./runtime/shopee-reports
ADMIN_HEALTH_CACHE_SECONDS=60
